    {
      "name": "00-Santé",
      "item": [
        {
          "name": "Santé UP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('statut 200', () => pm.response.to.have.status(200));",
                  "pm.test('application UP', () => pm.expect(pm.response.json().status).to.eql('UP'));",
                  "pm.test('base UP', () => pm.expect(pm.response.json().components.db.status).to.eql('UP'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          }
        },
