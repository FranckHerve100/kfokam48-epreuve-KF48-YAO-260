    {
      "name": "02-Sessions",
      "item": [
        {
          "name": "Ouvrir une session → 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('statut 201', () => pm.response.to.have.status(201));",
                  "const session = pm.response.json();",
                  "pm.test('champs du contrat', () => pm.expect(session).to.have.all.keys('id', 'code', 'ouvertureAt', 'expirationAt'));",
                  "pm.test('code de 6 caractères sans ambiguïté (H5)', () => pm.expect(session.code).to.match(/^[A-HJ-NP-Z2-9]{6}$/));",
                  "pm.test('expiration 15 min après l\\'ouverture (RG1)', () => pm.expect(new Date(session.expirationAt) - new Date(session.ouvertureAt)).to.eql(15 * 60 * 1000));",
                  "pm.collectionVariables.set('sessionId', session.id);",
                  "pm.collectionVariables.set('sessionCode', session.code);",
                  "pm.collectionVariables.set('sessionCodeMinuscule', session.code.toLowerCase());"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titre\": \"Parcours Postman\",\n  \"promotionId\": {{promotionId}}\n}",
              "options": {
