                  "const etudiants = pm.response.json();",
                  "pm.test('au moins deux étudiants { id, nom }', () => { pm.expect(etudiants.length).to.be.at.least(2); etudiants.forEach(e => pm.expect(e).to.have.all.keys('id', 'nom')); });",
                  "pm.test('triés par nom', () => pm.expect(etudiants.map(e => e.nom)).to.eql([...etudiants.map(e => e.nom)].sort((a, b) => a.localeCompare(b))));",
                  "pm.collectionVariables.set('etudiantId', etudiants[0].id);",
                  "pm.collectionVariables.set('etudiant2Id', etudiants[1].id);"
