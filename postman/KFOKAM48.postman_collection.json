    {
      "name": "99-Erreurs",
      "item": [
        {
          "name": "Route inconnue → 404 RESSOURCE_INCONNUE",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('statut 404', () => pm.response.to.have.status(404));",
                  "const corps = pm.response.json();",
                  "pm.test('code RESSOURCE_INCONNUE', () => pm.expect(corps.code).to.eql('RESSOURCE_INCONNUE'));",
                  "pm.test('format { code, message } uniquement', () => pm.expect(Object.keys(corps).sort()).to.eql(['code', 'message']));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
