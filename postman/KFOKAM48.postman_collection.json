    {
      "name": "01-Référentiel",
      "item": [
        {
          "name": "Promotions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('statut 200', () => pm.response.to.have.status(200));",
                  "const promotions = pm.response.json();",
                  "pm.test('liste { id, nom }', () => promotions.forEach(p => pm.expect(p).to.have.all.keys('id', 'nom')));",
                  "const yaounde = promotions.find(p => p.nom === 'KF48 Yaoundé');",
                  "pm.test('promotion de démonstration présente', () => pm.expect(yaounde).to.be.an('object'));",
                  "pm.collectionVariables.set('promotionId', yaounde.id);",
                  "const douala = promotions.find(p => p.nom === 'KF48 Douala');",
                  "pm.collectionVariables.set('promotionDoualaId', douala.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/promotions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "promotions"
              ]
            }
          }
        },
        {
          "name": "Sessions de la promotion",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('statut 200', () => pm.response.to.have.status(200));",
                  "const sessions = pm.response.json();",
                  "pm.test('champs du contrat', () => sessions.forEach(s => pm.expect(s).to.have.all.keys('id', 'titre', 'code', 'ouvertureAt', 'expirationAt', 'clotureAt')));",
                  "pm.test('session de démonstration EXPR22', () => pm.expect(sessions.map(s => s.code)).to.include('EXPR22'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
